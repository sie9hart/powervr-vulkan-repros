#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform writeonly image2D target;
layout(set = 0, binding = 1, std430) readonly buffer Src { uint words[]; };
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    uint w = words[(p.y * 64 + p.x) & 1023];
    imageStore(target, p, unpackUnorm4x8(w));
}
